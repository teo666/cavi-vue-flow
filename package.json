{
  "name": "cavi-vue-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Physics cables as Vue Flow edges, simulated by cavijs",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vue-flow/core": "^1.48.2",
    "cavijs": "^0.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
